# Firebase Admin SDK secrets for GitHub Actions.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional. Leave empty on Spark/free plan. Set only when using Blaze + Firebase Storage uploads.
FIREBASE_STORAGE_BUCKET=

# Optional AI summaries. Gemini is tried first, then Groq models, then OpenAI, then deterministic summaries.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GROQ_API_KEY=
GROQ_FALLBACK_MODELS=llama-3.3-70b-versatile,deepseek-r1-distill-llama-70b
OPENAI_API_KEY=

# Optional pipeline controls.
LIBRARY_MAX_BOOKS_PER_RUN=25
LIBRARY_BOOKS_PER_SOURCE=3
LIBRARY_LANGUAGES=english,hindi,bengali,sanskrit,tamil,urdu,marathi
LIBRARY_METADATA_ONLY=true
ENABLE_DLI_CONNECTOR=false
